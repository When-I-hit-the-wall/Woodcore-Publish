    "N/m³": ["kN/m³", "N/m³", "N/mm³"],
    "m": ["mm", "cm", "m"],
    "m²": ["mm²", "cm²", "m²"],
    "m³": ["mm³", "cm³", "m³"],
    "m⁴": ["mm⁴", "cm⁴", "m⁴"],
    "s": ["s", "min"],
    "g": ["kg", "t", "g"],
    "g/m³": ["kg/m³", "t/m³"],
    "deg": ["°"],
    "1": ["", "%", "‰"]
