{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Static models",
  "description": "data/statics.json, schema 1.1 -- every static model drawn in Woodcore, as lib/calc-engine.typ's show-static-model reads it (docs/domain/static-models.md §3.3octies). Generated by calc/domains/statics.py, never hand-edited. A model is a drawing and not a calculation: there is deliberately no {vars, steps, checks} record here, and nothing addresses one with show-calc. Coordinates are the figure's own units -- the model's frame, x right and z down, its longer side normalised -- the report only ever uses them to place a halo inside the same SVG.",
  "type": "object",
  "required": [
    "schema_version",
    "models"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1",
        "1.2"
      ],
      "description": "-- 1.1, or 1.2 where a model carries `links` or `texts`: an export written at another version is refused rather than read as this one."
    },
    "models": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "label",
            "source",
            "figures",
            "unit",
            "style",
            "points",
            "members",
            "supports",
            "releases",
            "dimensions",
            "loads",
            "labels",
            "unresolved"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "Free text, printed after the model's id in the figure's caption."
            },
            "source": {
              "type": "string",
              "description": "statics/<id>.json, the source it was exported from."
            },
            "unit": {
              "type": "number",
              "description": "The symbols' size unit in figure units, before the style sliders: what a halo is sized by."
            },
            "style": {
              "type": "object",
              "description": "The drawing's own three factors, as the source states them. One entry of any collection below may carry a `style` of its own beside them, and that one holds the factors that entry stated OVER these -- what it was drawn with, not what it was drawn at (v0.99).",
              "properties": {
                "line": {
                  "type": "number"
                },
                "point": {
                  "type": "number"
                },
                "text": {
                  "type": "number"
                }
              }
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "at",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "style": {
                    "type": "object",
                    "description": "The factor this point stated over the drawing's -- `text`, its label's, a point drawing nothing else (v0.99). Absent where it stated none, which is what leaves a record written before the factors existed unchanged.",
                    "properties": {
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "at",
                  "label",
                  "length_m"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "description": "'bar', 'cable' or 'spring'."
                  },
                  "at": {
                    "type": "array",
                    "description": "Its two ends, [[x, z], [x, z]].",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "length_m": {
                    "type": "number",
                    "description": "Its real length in metres -- the one figure here that is not in figure units."
                  },
                  "style": {
                    "type": "object",
                    "description": "The factors this member stated over the drawing's -- `line`, its stroke and the halo that covers it, and `text`, its label (v0.99). Absent where it stated none.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "supports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "point",
                  "type",
                  "at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "point": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "description": "'fixed', 'pinned' or 'roller'."
                  },
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "style": {
                    "type": "object",
                    "description": "The factors this support stated over the drawing's -- all three, its symbol being sized by `point`, stroked by `line` and named by `text` (v0.99). Absent where it stated none.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "point": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "releases": {
              "type": "array",
              "description": "Every release the figure draws, so that a halo can mark one; a release frees a degree of freedom at the node it is drawn on.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "member",
                  "end",
                  "dof",
                  "at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "member": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "dof": {
                    "type": "string"
                  },
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "style": {
                    "type": "object",
                    "description": "The factors this release stated over the drawing's -- all three; `point` is what its extent, and so the halo that covers it, follows (v0.99). Absent where it stated none.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "point": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "loads": {
              "type": "array",
              "description": "Every load the figure draws, with the number it shows and where that number came from -- which is what makes a value on a figure traceable to a cell of the workbook.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "label",
                  "show",
                  "text",
                  "unit",
                  "base_unit",
                  "from",
                  "at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "description": "'point' or 'line'."
                  },
                  "label": {
                    "type": "string"
                  },
                  "show": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string",
                    "description": "The colour its arrows are drawn in, by name: 'red' (where the source states none), 'green', 'orange', 'blue' or 'violet' (statics.LOAD_COLOURS). Additive: a record without it is a red load."
                  },
                  "text": {
                    "type": "string",
                    "description": "What the figure writes beside it, its lines joined by ' / '."
                  },
                  "value": {
                    "type": "number",
                    "description": "The magnitude as drawn, the influence width applied; absent where it could not be read."
                  },
                  "unit": {
                    "type": "string"
                  },
                  "base_value": {
                    "type": "number",
                    "description": "The magnitude before the influence width; absent where it could not be read."
                  },
                  "base_unit": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number",
                    "description": "The influence width b_e in metres; absent where the load carries none."
                  },
                  "width_label": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "description": "'domain/instance/var' where the magnitude names a variable of the export; empty for a value typed in Woodcore."
                  },
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "factor": {
                    "type": "number",
                    "description": "What the referenced var was multiplied by; absent where it was taken as it stands."
                  },
                  "offset": {
                    "type": "number",
                    "description": "What was added to it; absent where nothing was."
                  },
                  "description": {
                    "type": "string",
                    "description": "What the engineer wrote about this value, printed under the drawing."
                  },
                  "given": {
                    "type": "boolean",
                    "description": "Whether the load states a value at all."
                  },
                  "style": {
                    "type": "object",
                    "description": "The factors this load stated over the drawing's -- `line`, its arrows and **the length they are drawn at**, and `text`, its label (v0.99). Absent where it stated none, in which case its arrow is in proportion to its magnitude alone.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "labels": {
              "type": "array",
              "description": "Every id the model carries -- what `highlight` may name.",
              "items": {
                "type": "string"
              }
            },
            "unresolved": {
              "type": "array",
              "description": "The loads whose magnitude names a variable the export no longer has, as '<load>: <why>'. A warning at the export, never a reason to stop the report.",
              "items": {
                "type": "string"
              }
            },
            "width": {
              "type": "object",
              "description": "The model's own influence width, where it has one -- what its notes say it multiplied its loads by.",
              "properties": {
                "value": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            "figures": {
              "type": "object",
              "description": "The drawing, once per language a report can be written in (docs/typst/language.md §4bis), keyed by its code. One per language rather than one for all three because the notes are drawn inside the figure and its frame is sized to hold them: a longer sentence in one language widens that language's figure and no other. Everything else in this record -- the scale, the size unit and every placed point -- is geometry, and the same in all three.",
              "required": [
                "de",
                "fr",
                "en"
              ],
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "required": [
                    "file",
                    "view",
                    "notes"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "description": "statics/<id>-<lang>.svg under data/, the drawing the report sets."
                    },
                    "view": {
                      "type": "object",
                      "description": "The figure's viewBox: what show-static-model sizes the image by.",
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      }
                    },
                    "notes": {
                      "type": "array",
                      "description": "The lines the figure writes under the drawing: what was enlarged to stay visible, what an influence width is, what could not be read.",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "dimensions": {
              "type": "array",
              "description": "Every dimension written on the figure: what it measured, in metres for a length and in degrees for an angle, and where its value was set -- so that a halo may mark one and a caption may quote one. A dimension measures the drawing and changes nothing in it (docs/domain/static-models.md §3.3octies).",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "text",
                  "unit",
                  "at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "description": "'horizontal', 'vertical', 'parallel' or 'angle'."
                  },
                  "show": {
                    "type": "string",
                    "description": "What the figure writes beside it, a load's own four: 'none', 'name' (its label), 'value' or 'name+value' -- as the source states it, or as a dimension saved before it could say so reads (statics.dimension_show). Additive: a record without it wrote `text` all the same."
                  },
                  "text": {
                    "type": "string",
                    "description": "What the figure writes, by `show`: the value it measured with its unit, the label the engineer gave it, 'label = value', or '' for nothing. '?' for a value where the geometry no longer resolves."
                  },
                  "value": {
                    "type": "number",
                    "description": "What was measured -- metres or degrees. Absent where the geometry no longer resolves, the figure then writing '?'."
                  },
                  "unit": {
                    "type": "string"
                  },
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "Where the value is written, in figure units."
                  },
                  "line": {
                    "type": "array",
                    "description": "The two ends of the dimension line, for a length.",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "centre": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "The corner an angle turns about."
                  },
                  "radius": {
                    "type": "number",
                    "description": "The radius its arc is drawn at, in figure units."
                  },
                  "style": {
                    "type": "object",
                    "description": "The factors this dimension stated over the drawing's -- `line`, its witness lines, its heads and its arc, and `text`, its value (v0.99). Absent where it stated none. Its radius is the model's own geometry and no factor reaches it.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "links": {
              "type": "array",
              "description": "Where each field that follows a variable came from (REQ-012): the entry (its id, or \"model\"), the field, the variable, the factor and offset it was taken with, its own value and unit, and `stale` where it could not be read and the source's last value was drawn. Absent where none follows one.",
              "items": {
                "type": "object",
                "required": [
                  "entry",
                  "field",
                  "variable",
                  "factor",
                  "offset",
                  "base_value",
                  "base_unit",
                  "stale"
                ],
                "properties": {
                  "entry": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "variable": {
                    "type": "object",
                    "description": "A variable of the export this field follows (calc/domains/links.py, spec 2026-10-11-variables-liees-champs-et-textes D-17): the pair a call names its calculation by and its key -- a domain of the «Formule» tab carries origin \"formulas\" and its id as instance --, with an optional factor and offset (factor × variable + offset).",
                    "required": [
                      "domain",
                      "instance",
                      "var"
                    ],
                    "properties": {
                      "domain": {
                        "type": "string"
                      },
                      "instance": {
                        "type": "string"
                      },
                      "var": {
                        "type": "string"
                      },
                      "factor": {
                        "type": "number"
                      },
                      "offset": {
                        "type": "number"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "formulas"
                        ]
                      }
                    }
                  },
                  "factor": {
                    "type": "number"
                  },
                  "offset": {
                    "type": "number"
                  },
                  "base_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "base_unit": {
                    "type": "string"
                  },
                  "stale": {
                    "type": "boolean"
                  }
                }
              }
            },
            "texts": {
              "type": "array",
              "description": "The texts placed with the Text tool (issue #43): what each printed. Absent where the drawing has none.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "lines"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "description": "Its token text, as the source holds it."
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Its lines as printed, every token replaced by its variable."
                  },
                  "links": {
                    "type": "array",
                    "description": "Where each variable it printed came from (REQ-012).",
                    "items": {
                      "type": "object",
                      "required": [
                        "token",
                        "variable",
                        "stale"
                      ],
                      "properties": {
                        "token": {
                          "type": "string"
                        },
                        "variable": {
                          "type": "object",
                          "properties": {
                            "domain": {
                              "type": "string"
                            },
                            "instance": {
                              "type": "string"
                            },
                            "var": {
                              "type": "string"
                            },
                            "factor": {
                              "type": "number"
                            },
                            "offset": {
                              "type": "number"
                            },
                            "origin": {
                              "type": "string",
                              "description": "'formulas' for a domain of the «Formules» tab, whose id is `instance`; absent for the export."
                            }
                          }
                        },
                        "value": {},
                        "unit": {
                          "type": "string"
                        },
                        "stale": {
                          "type": "boolean",
                          "description": "True where the variable could not be read and its last value was printed (D-06)."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
