{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The engineer's library of materials",
  "description": "%APPDATA%\\Woodcore\\materials\\materials.json -- the materials the engineer makes in the «Matériaux» tab, for every project of his computer (calc/domains/materials_user.py, issue #110). One material's shape is calc/domains/materials_contract.py's, the same as a project's copy (materials.schema.json 2.0); its business rules are checked there.",
  "type": "object",
  "required": [
    "schema_version",
    "materials"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "-- pinned."
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "names",
          "category"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "u-<8 hex>, drawn once and never changed -- what a project's copy and a layer name."
          },
          "type": {
            "type": "string",
            "enum": [
              "member",
              "panel",
              "other"
            ]
          },
          "names": {
            "type": "object",
            "description": "The name in fr, de, en -- one at least.",
            "patternProperties": {
              "^(fr|de|en)$": {
                "type": "string"
              }
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "wood",
              "board",
              "ins",
              "tile",
              "memb",
              "gyps",
              "conc",
              "metal",
              "floor",
              "fill",
              "direct"
            ]
          },
          "comment": {
            "type": "string"
          },
          "weight": {
            "type": "object",
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number",
                "description": "Above 0."
              },
              "unit": {
                "type": "string",
                "enum": [
                  "kN/m³",
                  "kN/m²"
                ]
              },
              "ref": {
                "type": "string",
                "description": "Where the weight comes from."
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "none",
                  "url",
                  "pdf",
                  "norm",
                  "book"
                ]
              },
              "url": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "A PDF's copy, relative to the library's folder: sources/<name>.pdf."
              },
              "ref": {
                "type": "string"
              }
            }
          },
          "family": {
            "type": "string",
            "enum": [
              "softwood",
              "hardwood",
              "glulam"
            ],
            "description": "A member's: what gives γ_M/η_M and the design values the norm sets."
          },
          "values": {
            "type": "object",
            "description": "A member's strengths f_<s>_k and f_<s>_d, its moduli and ρ_k -- N/mm², kg/m³.",
            "patternProperties": {
              "^.*$": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "product": {
            "type": [
              "string",
              "null"
            ],
            "description": "A panel's: its row of SIA 265/1 Tabelle 9, what gives γ_M and η_mod; null for a panel of one's own whose product is not named (no design value deduced)."
          },
          "isotropic": {
            "type": "boolean",
            "description": "A panel with one value for both directions (particle and fibre boards)."
          },
          "columns": {
            "type": "array",
            "description": "A panel's ranges of thickness, one column each; empty for one column.",
            "items": {
              "type": "object",
              "properties": {
                "t_min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "t_max": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "thickness": {
            "type": [
              "number",
              "null"
            ],
            "description": "A panel's thickness in mm, optional: empty, the values hold for any."
          },
          "rho_k": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "grid": {
            "type": "object",
            "description": "A panel's values: {plate|shear|axial: {key: {par|perp|all: [one per column]}}}.",
            "patternProperties": {
              "^.*$": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {
                        "type": "array",
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
