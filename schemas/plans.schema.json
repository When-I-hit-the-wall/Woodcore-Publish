{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Position plans",
  "description": "data/plans.json, schema 1.3 --every position plan saved in Woodcore, as lib/calc-engine.typ's show-plan reads it (docs/domain/position-plans.md §3.3sexies). Generated by calc/domains/plan.py, never hand-edited. Coordinates are in the units of each plan's sheet, y down.",
  "type": "object",
  "required": [
    "schema_version",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.3",
        "1.4"
      ],
      "description": "-- 1.3, or 1.4 where a plan carries `texts` (issue #43): an export written at another version is refused rather than read as this one."
    },
    "plans": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "label",
            "floor",
            "source",
            "sheet",
            "crop",
            "overlay",
            "legend",
            "unit",
            "style",
            "elements",
            "axes",
            "labels",
            "unknown",
            "storey",
            "role"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "floor": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "description": "plans/<id>.json, the source it was exported from."
            },
            "sheet": {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              }
            },
            "crop": {
              "type": "object",
              "description": "The frame the report shows, in sheet units: the overlay's viewBox.",
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                }
              }
            },
            "background": {
              "type": "object",
              "description": "The background as the report sets it, under data/: a PDF reduced to the page drawn on, or the image copied. Absent for a plan drawn on an empty sheet. Since 1.3 a plan drawn on a document (`document`) sets that document's page flattened -- its switched-off layers taken out -- or a drawing's layout as an SVG (format svg).",
              "required": [
                "file",
                "format",
                "page",
                "origin",
                "origin_page",
                "sha256",
                "opacity"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "page": {
                  "type": "number"
                },
                "origin": {
                  "type": "string",
                  "description": "The file it was taken from, relative to the project folder."
                },
                "origin_page": {
                  "type": "number"
                },
                "sha256": {
                  "type": "string"
                },
                "opacity": {
                  "type": "number"
                },
                "document": {
                  "type": "string",
                  "description": "The document of plans/documents/ the background was made from (1.3); absent for a plan drawn on its file directly."
                },
                "rotation": {
                  "type": "number",
                  "description": "The rotation the document's page was given, degrees clockwise (1.3)."
                },
                "layers_off": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The layers taken out of it, sorted (1.3)."
                }
              }
            },
            "overlay": {
              "type": "string",
              "description": "The symbols' SVG under data/, its viewBox the crop."
            },
            "legend": {
              "type": "array",
              "description": "The legend's lines, one per symbol the plan uses, in the order show-plan lists them.",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "text",
                  "swatch"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "The symbol: a type, a type and its subtype (D:scheibe), or Achse."
                  },
                  "text": {
                    "type": "string",
                    "description": "What it stands for, in STE's words."
                  },
                  "swatch": {
                    "type": "string",
                    "description": "The symbol drawn, as an SVG document in mm."
                  },
                  "quantity": {
                    "type": "object",
                    "description": "What the plan holds of this symbol, on a plan with a scale (v0.117, calc/domains/plan.py quantities): the lines summed in metres (unit m, to the centimetre), the areas in square metres (m2, to the hundredth), the points counted (pcs). Optional and additive: the export stays 1.3.",
                    "required": [
                      "value",
                      "unit"
                    ],
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "m",
                          "m2",
                          "pcs"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "unit": {
              "type": "number",
              "description": "The symbols' size unit in sheet units, before the style sliders: what show-plan sizes a highlight by."
            },
            "style": {
              "type": "object",
              "description": "The plan's own three factors on the unit above -- what every element and every axis is drawn with unless it carries a `style` of its own.",
              "properties": {
                "line": {
                  "type": "number"
                },
                "point": {
                  "type": "number"
                },
                "text": {
                  "type": "number"
                }
              }
            },
            "scale": {
              "type": "object",
              "required": [
                "mode",
                "units_per_m"
              ],
              "properties": {
                "mode": {
                  "type": "string"
                },
                "units_per_m": {
                  "type": "number"
                },
                "ratio": {
                  "type": "number"
                }
              }
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "label",
                  "kind",
                  "points"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "subtype": {
                    "type": "string"
                  },
                  "angle": {
                    "type": "number",
                    "description": "A point load's horizontal direction, in degrees (v0.116); absent: 0."
                  },
                  "label": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "length_m": {
                    "type": "number"
                  },
                  "label_at": {
                    "type": "array",
                    "description": "[x, y], the centre of the element's position number as the overlay draws it -- in its own place or where it was moved to by hand, and at this element's own text factor; absent for an element without a number. A detail frames it with the element.",
                    "items": {
                      "type": "number"
                    }
                  },
                  "style": {
                    "type": "object",
                    "description": "Only the factors this element states over the plan's three (v0.99) -- absent where it states none, which is what «follows the plan» looks like. The record then says what the overlay beside it was drawn with; show-plan reads the plan's `style` and this one's `unit` for its halo, and nothing here.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "point": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "axes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "point",
                  "angle",
                  "bubbles",
                  "segment"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "point": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "angle": {
                    "type": "number"
                  },
                  "bubbles": {
                    "type": "string"
                  },
                  "segment": {
                    "type": "array",
                    "description": "Where the axis crosses the crop, [start, end]; empty where it misses it."
                  },
                  "style": {
                    "type": "object",
                    "description": "Only the factors this axis states over the plan's (v0.99) -- `line`, `text`, and absent where it states none. An axis places no symbol on a point, so it carries no `point`.",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "text": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "labels": {
              "type": "array",
              "description": "Every position number the plan shows, in the order its elements were drawn.",
              "items": {
                "type": "string"
              }
            },
            "unknown": {
              "type": "array",
              "description": "Those Positionen.xlsx did not have at the export.",
              "items": {
                "type": "string"
              }
            },
            "storey": {
              "type": "string",
              "description": "The storey the plan shows, free text; \"\" where it states none (1.3)."
            },
            "role": {
              "type": "string",
              "enum": [
                "plan",
                "section"
              ],
              "description": "A floor plan or a section (1.3)."
            },
            "section_plan": {
              "type": "string",
              "description": "The section plan a floor plan refers to; absent where it names none (1.3)."
            },
            "plan_type": {
              "type": "string",
              "enum": [
                "floor",
                "section",
                "loadpath"
              ],
              "description": "The plan's type, where its source states one (v0.116): a floor plan, an elevation section or a load-path plan; absent, a floor plan or a section by its role. Additive: the export stays 1.3."
            },
            "figures": {
              "type": "object",
              "description": "A section carrying a load transfer level, drawn once per language (v0.116) -- the level writes «Niveau de reprise des charges (x0xx)» -- as {de, fr, en: plans/<id>-<lang>.svg}; show-plan sets the report's. Absent from every other plan, whose one overlay serves every language.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "dimensions": {
              "type": "array",
              "description": "Additive (issue #9), written only where the plan has a dimension it can measure: each one's kind, its points in sheet units, what it measures -- one value for a linear one or an angle, one a segment for a chain -- and its unit, m or °, computed from the source's points and the plan's scale.",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "points",
                  "values",
                  "unit"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "points": {
                    "type": "array"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "m",
                      "°"
                    ]
                  }
                }
              }
            },
            "load_levels": {
              "type": "array",
              "description": "A section's load transfer levels (v0.116): its storey, its STE designation (x0xx), its numbering character where it states one, and its two points in sheet units.",
              "items": {
                "type": "object",
                "required": [
                  "storey",
                  "designation",
                  "points"
                ],
                "properties": {
                  "storey": {
                    "type": "string"
                  },
                  "designation": {
                    "type": "string"
                  },
                  "floor": {
                    "type": "string"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "storey_lines": {
              "type": "array",
              "description": "A section's storey lines, in sheet units; on a section only (1.3).",
              "items": {
                "type": "object",
                "required": [
                  "storey",
                  "points"
                ],
                "properties": {
                  "storey": {
                    "type": "string"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "storey_boxes": {
              "type": "array",
              "description": "A section's storey boxes, {x, y, w, h} in sheet units; on a section only (1.3). show-plan and sheet-section draw the one a call highlights.",
              "items": {
                "type": "object",
                "required": [
                  "storey",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "properties": {
                  "storey": {
                    "type": "string"
                  },
                  "floor": {
                    "type": "string",
                    "description": "The storey's numbering character, where the box states one (v0.116): its STE designation x1xx is made of it."
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                }
              }
            },
            "texts": {
              "type": "array",
              "description": "The texts placed with the Text tool (issue #43): what each printed. Absent where the drawing has none.",
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "lines",
                  "point"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Its token text, as the source holds it."
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Its lines as printed, every token replaced by its variable."
                  },
                  "links": {
                    "type": "array",
                    "description": "Where each variable it printed came from (REQ-012).",
                    "items": {
                      "type": "object",
                      "required": [
                        "token",
                        "variable",
                        "stale"
                      ],
                      "properties": {
                        "token": {
                          "type": "string"
                        },
                        "variable": {
                          "type": "object",
                          "properties": {
                            "domain": {
                              "type": "string"
                            },
                            "instance": {
                              "type": "string"
                            },
                            "var": {
                              "type": "string"
                            },
                            "factor": {
                              "type": "number"
                            },
                            "offset": {
                              "type": "number"
                            },
                            "origin": {
                              "type": "string",
                              "description": "'formulas' for a domain of the «Formules» tab, whose id is `instance`; absent for the export."
                            }
                          }
                        },
                        "value": {},
                        "unit": {
                          "type": "string"
                        },
                        "stale": {
                          "type": "boolean",
                          "description": "True where the variable could not be read and its last value was printed (D-06)."
                        }
                      }
                    }
                  },
                  "point": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "Its centre on the sheet."
                  },
                  "id": {
                    "type": "string",
                    "description": "A fire-protection plan's text's id; a position plan's texts have none, as its other entries."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
